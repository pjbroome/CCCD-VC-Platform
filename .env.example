# Sutton AI Brand Ambassador - Environment Configuration
# Copy this file to .env and fill in your values

# --- LLM Provider (Required) ---
# Options: "anthropic" (Claude) or "gemini" (Gemini)
LLM_PROVIDER=anthropic

# --- Anthropic / Claude (Primary) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
SUTTON_MODEL=claude-sonnet-4-20250514
CRITIC_MODEL=claude-sonnet-4-20250514

# --- Gemini AI (Fallback + Embeddings) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- RAG System ---
RAG_ENABLED=true
TRAINING_DATA_DIR=/app/training_data

# --- Supabase (Required for logging and dashboard) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# --- Crown Council Content Monitor (Optional) ---
CROWN_COUNCIL_EMAIL=your-crown-council-email
CROWN_COUNCIL_PASSWORD=your-crown-council-password
