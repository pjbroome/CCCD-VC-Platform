# Sutton AI Brand Ambassador - Environment Configuration
# Copy this file to .env and fill in your values

# --- LLM Provider (Required) ---
# Options: "gemini" (recommended) or "anthropic" (Claude - fallback)
LLM_PROVIDER=gemini

# --- Gemini AI (Primary + Embeddings) ---
GEMINI_API_KEY=your-gemini-api-key-here
SUTTON_MODEL=gemini-2.5-pro
CRITIC_MODEL=gemini-2.5-flash
SUTTON_TEMPERATURE=0.8

# --- Anthropic / Claude (Fallback) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- RAG System ---
RAG_ENABLED=true
TRAINING_DATA_DIR=/app/training_data

# --- Supabase (Required for logging and dashboard) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# --- Crown Council Content Monitor (Optional) ---
CROWN_COUNCIL_EMAIL=your-crown-council-email
CROWN_COUNCIL_PASSWORD=your-crown-council-password
